---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Seeking Gradient">
	<div>
		{/* Hero Section */}
		<section class="py-20 text-center border-b border-gray-100 mb-20">
			<div class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-white uppercase bg-gradient-to-r from-purple-500 to-orange-500 rounded-full">
				Welcome to my digital space
			</div>
			<h1 class="text-6xl font-black mb-6 tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 pb-2">
				Seeking Gradient
			</h1>
			<p class="text-xl text-gray-500 max-w-2xl mx-auto font-light leading-relaxed mb-10">
				Always seeking continuous improvement and learning. Building, experimenting, and growing, one step at a time.
			</p>
			<div class="flex justify-center gap-4">
				<a href="#blog" class="px-8 py-3 bg-gray-900 text-white font-bold rounded-lg hover:bg-gray-800 transition shadow-lg shadow-gray-200">
					Read Blog
				</a>
				<a href="mailto:seekinggradient@gmail.com" class="px-8 py-3 border border-gray-200 text-gray-600 font-bold rounded-lg hover:border-gray-900 hover:text-gray-900 transition">
					Get in Touch
				</a>
			</div>
		</section>

		<div class="max-w-4xl mx-auto" id="blog">
			<div class="flex items-center gap-4 mb-12">
				<div class="h-px flex-1 bg-gray-100"></div>
				<h2 class="text-xs font-black uppercase tracking-[0.3em] text-gray-400">Latest Essays</h2>
				<div class="h-px flex-1 bg-gray-100"></div>
			</div>

			<div class="space-y-24">
				{posts.map((post) => (
					<article class="group relative">
						<a href={`/blog/${post.slug}`} class="block">
							<div class="flex items-center gap-3 mb-4">
								<time class="text-xs font-bold text-orange-500 tracking-wider">
									{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase()}
								</time>
								<span class="w-1 h-1 rounded-full bg-gray-300"></span>
								<span class="text-xs font-bold text-gray-400 uppercase tracking-widest">{post.data.author}</span>
							</div>
							<h3 class="text-3xl font-black mb-4 group-hover:text-purple-600 transition-colors duration-300 tracking-tight leading-tight">
								{post.data.title}
							</h3>
							<p class="text-lg text-gray-600 leading-relaxed font-light mb-6 line-clamp-3">
								{post.data.description}
							</p>
							<div class="flex items-center gap-2 text-sm font-bold text-gray-900 group-hover:gap-4 transition-all duration-300">
								READ STORY <span class="text-xl">→</span>
							</div>
						</a>
					</article>
				))}
			</div>
		</div>
	</div>
</Layout>
