---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
	title="Seeking Gradient"
	description="Seeking Gradient is a personal site about autonomous agents, infrastructure experiments, and continuous learning through building."
	canonicalPath="/"
	ogType="website"
>
	<div>
		{/* Hero Section */}
		<section class="py-12 sm:py-20 border-b border-[color:var(--color-rule)] mb-20">
			<div class="max-w-5xl">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-accent)] mb-8">
					Welcome to my digital space
				</p>
				<h1 class="display text-6xl sm:text-7xl md:text-8xl mb-8 max-w-4xl">
					Seeking <span class="display-italic">Gradient</span>
				</h1>
				<p class="text-xl sm:text-2xl text-[color:var(--color-ink-mute)] max-w-2xl leading-relaxed mb-10">
					Always seeking continuous improvement and learning. Building, experimenting, and growing, one step at a time.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 text-sm">
					<a href="#blog" class="inline-flex items-center justify-center border border-[color:var(--color-ink)] bg-[color:var(--color-ink)] text-[color:var(--color-paper)] px-6 py-3 hover:bg-[color:var(--color-accent)] hover:border-[color:var(--color-accent)] transition-colors">
						Read Blog
					</a>
					<a href="/ideas" class="inline-flex items-center justify-center border border-[color:var(--color-rule)] bg-[color:var(--color-paper-deep)] text-[color:var(--color-ink)] px-6 py-3 hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] transition-colors">
						Browse Ideas
					</a>
					<a href="mailto:seekinggradient@gmail.com" class="inline-flex items-center justify-center border border-[color:var(--color-rule)] px-6 py-3 text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-ink)] hover:text-[color:var(--color-ink)] transition-colors">
						Get in Touch
					</a>
				</div>
			</div>
		</section>

		<section class="max-w-5xl mx-auto mb-20 border-y border-[color:var(--color-rule)] py-10">
			<div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-accent)] mb-4">Public notebook</p>
					<h2 class="display text-4xl sm:text-5xl text-[color:var(--color-ink)] mb-5">Ideas <span class="display-italic">Repository</span></h2>
					<p class="text-lg text-[color:var(--color-ink-mute)] leading-relaxed max-w-2xl">
						A growing archive of product and systems ideas, with static pages, visual mockups, and architecture sketches as concepts mature.
					</p>
				</div>
				<a href="/ideas" class="link-underline pb-1 text-[color:var(--color-accent)] whitespace-nowrap">
					Open notebook →
				</a>
			</div>
		</section>

		<div class="max-w-4xl mx-auto" id="blog">
			<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 mb-12">
				<div class="editorial-rule h-px"></div>
				<h2 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Latest Essays</h2>
				<div class="editorial-rule h-px"></div>
			</div>

			<div class="space-y-20">
				{posts.map((post) => (
					<article class="group relative border-b border-[color:var(--color-rule)] pb-12 last:border-b-0">
						<a href={`/blog/${post.slug}`} class="block">
							<div class="flex flex-wrap items-center gap-3 mb-5 font-mono text-xs text-[color:var(--color-ink-mute)]">
								<time class="text-[color:var(--color-accent)]">
									{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase()}
								</time>
								<span class="h-px w-6 bg-[color:var(--color-rule)]"></span>
								<span>{post.data.author}</span>
							</div>
							<h3 class="display text-4xl sm:text-5xl mb-5 group-hover:text-[color:var(--color-accent)] transition-colors">
								{post.data.title}
							</h3>
							<p class="text-lg text-[color:var(--color-ink-mute)] leading-relaxed mb-6 line-clamp-3">
								{post.data.description}
							</p>
							<div class="inline-flex items-center gap-2 text-sm text-[color:var(--color-ink)] group-hover:text-[color:var(--color-accent)] transition-colors">
								Read story <span aria-hidden="true">→</span>
							</div>
						</a>
					</article>
				))}
			</div>
		</div>
	</div>
</Layout>
