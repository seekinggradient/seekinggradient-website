---
import Layout from '../layouts/Layout.astro';
import dashboard from '../data/rfc-dashboard.json';

// DATA PATH — build-time import (deliberate, not the first choice).
//   The preferred design was a client-side fetch of the Hub RAW url
//   (hub.agentsfs.ai/seekinggradient/seekinggradient-hq/raw/rfc-dashboard.json)
//   so the page would always show live data. It is BLOCKED on two counts,
//   verified 2026-07-28: (1) the repo is private, so the raw route 302-redirects
//   to /login; (2) the Hub sends no Access-Control-Allow-Origin header, so a
//   cross-origin browser fetch from seekinggradient.com is refused even with a
//   Hub session. So we fall back to the documented build-time copy: the JSON is
//   generated by seekinggradient-hq/tools/rfc_dashboard.py and copied to
//   src/data/rfc-dashboard.json. Refresh it by rerunning that script (never edit
//   by hand).
//   PRIVACY: this bakes RFC titles/descriptions (portfolio strategy) into the
//   built output. seekinggradient.com production is PUBLIC, so this page must NOT
//   be deployed to public prod without an access gate — verify locally only.
const { meta, rfcs } = dashboard as {
	meta: {
		generated: string;
		search_root: string;
		discovery: string;
		instances_scanned: number;
		instances_with_rfcs: number;
		discovery_complete?: boolean | null;
		discovery_incomplete_roots?: string[];
	};
	rfcs: Array<{
		name: string;
		kb: string;
		on_hub: boolean;
		url: string | null;
		path: string;
		rfc_status: string;
		rfc_scope: string;
		rfc_decided: string;
		owner_approved: boolean;
		approvers: Array<{ kind: string; id: string; model: string; date: string }>;
		description: string;
	}>;
};

const STATUS_ORDER = ['draft', 'proposed', 'accepted', 'implemented', 'superseded', 'archived'];

const groups = STATUS_ORDER
	.map((status) => ({ status, rows: rfcs.filter((r) => r.rfc_status === status) }))
	.filter((g) => g.rows.length > 0);

const ownerApproved = rfcs.filter((r) => r.owner_approved).length;

// Surface partial discovery the same way the .md and JSON do: loudly. Only fires
// when afs status reported an incomplete walk (scopes[].complete === false).
const partialDiscovery = meta.discovery_complete === false;
const incompleteRoots = meta.discovery_incomplete_roots ?? [];

function compressApprover(a: { kind: string; id: string; model: string }) {
	if (a.kind === 'human') return a.id || '?';
	const model = a.model || '';
	let short = model.startsWith('claude-') ? model.slice('claude-'.length) : model;
	short = short ? short.split('-')[0] : 'agent';
	const m = (a.id || '').match(/[0-9a-f]{8}/);
	const idShort = m ? m[0] : (a.id || '').slice(0, 8) || '?';
	return `${short}@${idShort}`;
}

function compressApprovers(approvers: Array<{ kind: string; id: string; model: string }>) {
	if (!approvers || approvers.length === 0) return '—';
	return approvers.map(compressApprover).join(', ');
}

const statusTint: Record<string, string> = {
	draft: 'var(--color-lilac)',
	proposed: 'var(--color-accent-soft)',
	accepted: 'var(--color-mint)',
	implemented: 'var(--color-yellow)',
	superseded: 'var(--color-orange)',
	archived: 'var(--color-rule)',
};
---

<Layout
	title="RFCs | Seeking Gradient"
	description="The SeekingGradient portfolio RFC dashboard — every design decision on record, by lifecycle status, discovered across the portfolio's knowledge bases."
	canonicalPath="/rfcs"
	ogType="website"
>
	<section class="pb-10 sm:pb-14">
		<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-accent)]">The record</p>
		<h1 class="display mt-5 text-6xl sm:text-7xl">RFC <span>dashboard</span>.</h1>
		<p class="mt-6 max-w-2xl text-lg leading-8 text-[color:var(--color-ink-mute)]">
			Every load-bearing decision across the SeekingGradient portfolio, on record. Each RFC
			states a problem, surveys the options with citations, and ends with a recommendation —
			detected anywhere in any of the portfolio's knowledge bases by a single frontmatter key.
		</p>
		<p class="mt-5 font-mono text-[12px] text-[color:var(--color-ink-mute)]">
			{rfcs.length} RFCs · {meta.instances_with_rfcs} knowledge base(s) · owner-approved {ownerApproved}/{rfcs.length} · generated {meta.generated}
		</p>
	</section>

	{partialDiscovery && (
		<div
			class="mb-12 rounded-md border-l-4 px-5 py-4 text-[13px] leading-6"
			style="border-color:var(--color-orange);background:color-mix(in srgb, var(--color-orange) 12%, transparent)"
			role="alert"
		>
			<strong class="font-mono uppercase tracking-wider text-[12px]">⚠ Partial discovery.</strong>{' '}
			The portfolio walk did not finish{incompleteRoots.length > 0 ? ` (${incompleteRoots.join(', ')})` : ''},
			so any RFC under an unwalked path is missing here — the list below is a floor, not the whole portfolio.
		</div>
	)}

	{groups.map((group) => (
		<section class="mb-14">
			<div class="flex items-center gap-3 border-b border-[color:var(--color-ink)] pb-2">
				<span
					class="inline-block h-3 w-3 rounded-full"
					style={`background:${statusTint[group.status] ?? 'var(--color-rule)'}`}
				></span>
				<h2 class="font-serif text-2xl capitalize">{group.status}</h2>
				<span class="font-mono text-[12px] text-[color:var(--color-ink-mute)]">{group.rows.length}</span>
			</div>

			<ol class="mt-2">
				{group.rows.map((r) => (
					<li class="border-b border-[color:var(--color-rule)] py-6">
						<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
							<h3 class="font-serif text-xl leading-tight">
								{r.url ? (
									<a
										href={r.url}
										target="_blank"
										rel="noopener"
										class="link-underline transition-colors hover:text-[color:var(--color-accent)]"
									>{r.name} ↗</a>
								) : (
									<span>{r.name} <span class="font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-ink-mute)]">local only</span></span>
								)}
							</h3>
							<span
								class="shrink-0 rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider"
								style={r.owner_approved
									? 'border-color:var(--color-mint);background:color-mix(in srgb, var(--color-mint) 30%, transparent);color:var(--color-ink)'
									: 'border-color:var(--color-rule);color:var(--color-ink-mute)'}
								title={r.owner_approved ? 'Akshay has personally approved this RFC' : 'awaiting Akshay’s personal sign-off'}
							>{r.owner_approved ? '✓ owner-approved' : '✗ owner pending'}</span>
						</div>

						<p class="mt-2 max-w-4xl text-[14px] leading-6 text-[color:var(--color-ink-mute)]">{r.description}</p>

						<div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11px] text-[color:var(--color-ink-mute)]">
							<span>{r.kb}</span>
							{r.rfc_scope && <span>scope: {r.rfc_scope}</span>}
							{r.rfc_decided && <span>decided: {r.rfc_decided}</span>}
							<span>approvers: {compressApprovers(r.approvers)}</span>
						</div>
					</li>
				))}
			</ol>
		</section>
	))}

	<section class="mt-16 border-t border-[color:var(--color-rule)] pt-8 font-mono text-[11px] leading-6 text-[color:var(--color-ink-mute)]">
		<p>Generated by <code>seekinggradient-hq/tools/rfc_dashboard.py</code> · discovery: {meta.discovery} · {meta.instances_scanned} instance(s) scanned{meta.discovery_complete === true ? ' (complete coverage)' : meta.discovery_complete === false ? ' (partial — see notice above)' : ''}. Most carry no RFC; the count keeps coverage visible.</p>
		<p class="mt-1">Owner approval is pending review — RFCs are agent-accepted but not yet personally signed. The owner flag flips as each is read.</p>
	</section>
</Layout>
