---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="404 — Page Not Found | Seeking Gradient"
	description="The page you requested could not be found on Seeking Gradient."
	canonicalPath="/404"
	ogType="website"
>
	<section class="py-24 text-center">
		<p class="text-xs font-black uppercase tracking-[0.3em] text-orange-500 mb-6">404</p>
		<h1 class="text-5xl font-black tracking-tighter mb-6">Page not found</h1>
		<p class="text-lg text-gray-500 max-w-xl mx-auto mb-10">
			The page you’re looking for doesn’t exist or may have moved.
		</p>
		<a href="/" class="px-8 py-3 bg-gray-900 text-white font-bold rounded-lg hover:bg-gray-800 transition shadow-lg shadow-gray-200">
			Return home
		</a>
	</section>
</Layout>
