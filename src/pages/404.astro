---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="404 — Page Not Found | Seeking Gradient"
	description="The page you requested could not be found on Seeking Gradient."
	canonicalPath="/404"
	ogType="website"
>
	<section class="py-24 text-center">
		<p class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-accent)] mb-6">404</p>
		<h1 class="display text-5xl sm:text-6xl mb-6">Page not <span class="display-italic">found</span></h1>
		<p class="text-lg text-[color:var(--color-ink-mute)] max-w-xl mx-auto mb-10">
			The page you’re looking for doesn’t exist or may have moved.
		</p>
		<a href="/" class="inline-flex border border-[color:var(--color-ink)] bg-[color:var(--color-ink)] text-[color:var(--color-paper)] px-6 py-3 hover:bg-[color:var(--color-accent)] hover:border-[color:var(--color-accent)] transition-colors">
			Return home
		</a>
	</section>
</Layout>
