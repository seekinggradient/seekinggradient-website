---
import IdeasApp from '../../ideas/App';
import { ideas } from '../../ideas/data/ideas';
import '../../ideas/index.css';

export function getStaticPaths() {
  return [
    { params: { path: 'about' } },
    { params: { path: 'mockups' } },
    ...ideas.map((idea) => ({ params: { path: idea.slug } })),
  ];
}

const path = Astro.params.path ?? '';
const idea = ideas.find((entry) => entry.slug === path);
const title = idea ? `${idea.title} - Seeking Gradient` : 'Ideas - Seeking Gradient';
const description = idea?.tagline ?? 'A working notebook of product and systems ideas by Seeking Gradient.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f2ea" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://seekinggradient.com/ideas/${path}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <IdeasApp client:only="react" />
  </body>
</html>
