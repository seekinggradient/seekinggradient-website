---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

// Load build-time tracking data
const dataPath = path.join(process.cwd(), 'data', 'tracking.json');
let tracking = { generatedAt: null, stocks: [], crypto: [], hackerNews: [], techCrunch: [] };
try {
	const raw = fs.readFileSync(dataPath, 'utf-8');
	tracking = JSON.parse(raw);
} catch {
	// data/tracking.json missing — page renders with empty state
}

const { generatedAt, stocks, crypto, hackerNews, techCrunch, podcasts } = tracking;

/** Format a price as $X,XXX.XX */
function fmtPrice(n: number | null): string {
	if (n == null) return '—';
	return n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
}

/** Format a percentage with sign and color class */
function fmtChange(n: number | null): { text: string; cls: string } {
	if (n == null) return { text: '—', cls: 'text-[color:var(--color-ink-mute)]' };
	const sign = n >= 0 ? '+' : '';
	const text = `${sign}${n.toFixed(2)}%`;
	const cls = n >= 0 ? 'text-green-600' : 'text-red-500';
	return { text, cls };
}

/** Format ISO date to a readable string */
function fmtDate(iso: string | null): string {
	if (!iso) return 'Unknown';
	const d = new Date(iso);
	return d.toLocaleDateString('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
		hour: '2-digit',
		minute: '2-digit',
		timeZoneName: 'short',
	});
}
---

<Layout
	title="What I'm Tracking | Seeking Gradient"
	description="A live dashboard of stocks, crypto, Hacker News, and TechCrunch headlines that I'm keeping an eye on."
	canonicalPath="/tracking"
	ogType="website"
>
	<div>
		{/* Page Header */}
		<section class="pb-12 border-b border-[color:var(--color-rule)] mb-12">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-accent)] mb-6">
				Dashboard
			</p>
			<h1 class="display text-5xl sm:text-6xl mb-5">What I'm <span class="display-italic">Tracking</span></h1>
			<p class="text-lg text-[color:var(--color-ink-mute)] max-w-2xl leading-relaxed">
				A snapshot of the markets, crypto, and tech news I'm following. Refreshed at each site build.
			</p>
			{generatedAt && (
				<p class="mt-4 font-mono text-xs text-[color:var(--color-ink-mute)]">
					Last updated: {fmtDate(generatedAt)}
				</p>
			)}
		</section>

		<div class="max-w-4xl mx-auto space-y-16">

			{/* ── Podcasts ── */}
			{podcasts && (
				<section>
					<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 mb-8">
						<div class="editorial-rule h-px"></div>
						<h2 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Podcasts</h2>
						<div class="editorial-rule h-px"></div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						{podcasts.hackerNews && (
							<div class="bg-[color:var(--color-paper-deep)] border border-[color:var(--color-rule)] p-6">
								<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] mb-4">Hacker News</h3>
								<audio src={podcasts.hackerNews} controls class="w-full h-8" />
							</div>
						)}
						{podcasts.openclaw && (
							<div class="bg-[color:var(--color-paper-deep)] border border-[color:var(--color-rule)] p-6">
								<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] mb-4">r/openclaw</h3>
								<audio src={podcasts.openclaw} controls class="w-full h-8" />
							</div>
						)}
						{podcasts.worldnews && (
							<div class="bg-[color:var(--color-paper-deep)] border border-[color:var(--color-rule)] p-6">
								<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] mb-4">r/worldnews</h3>
								<audio src={podcasts.worldnews} controls class="w-full h-8" />
							</div>
						)}
					</div>
				</section>
			)}

			{/* ── Markets & Stocks ── */}
			<section>
				<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 mb-8">
					<div class="editorial-rule h-px"></div>
					<h2 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Markets &amp; Stocks</h2>
					<div class="editorial-rule h-px"></div>
				</div>

				{stocks.length === 0 ? (
					<p class="text-[color:var(--color-ink-mute)] text-sm italic">No stock data available.</p>
				) : (
					<div class="overflow-x-auto">
						<table class="w-full text-left">
							<thead>
								<tr class="border-b border-[color:var(--color-rule)]">
									<th class="pb-3 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Symbol</th>
									<th class="pb-3 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] text-right">Price</th>
									<th class="pb-3 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] text-right">Change</th>
								</tr>
							</thead>
							<tbody>
								{stocks.map((s: any) => {
									const change = fmtChange(s.change);
									return (
										<tr class="border-b border-[color:var(--color-rule)]">
											<td class="py-4">
												<span class="font-semibold text-[color:var(--color-ink)]">{s.symbol}</span>
												{s.name && <span class="ml-2 text-sm text-[color:var(--color-ink-mute)]">{s.name}</span>}
											</td>
											<td class="py-4 text-right tabular-nums">
												{s.price != null
													? fmtPrice(s.price)
													: <span class="text-[color:var(--color-ink-mute)] italic text-sm">Unavailable</span>
												}
											</td>
											<td class={`py-4 text-right font-semibold tabular-nums ${change.cls}`}>
												{change.text}
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				)}
			</section>

			{/* ── Crypto ── */}
			<section>
				<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 mb-8">
					<div class="editorial-rule h-px"></div>
					<h2 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Crypto</h2>
					<div class="editorial-rule h-px"></div>
				</div>

				{crypto.length === 0 ? (
					<p class="text-[color:var(--color-ink-mute)] text-sm italic">No crypto data available.</p>
				) : (
					<div class="overflow-x-auto">
						<table class="w-full text-left">
							<thead>
								<tr class="border-b border-[color:var(--color-rule)]">
									<th class="pb-3 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Asset</th>
									<th class="pb-3 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] text-right">Price</th>
									<th class="pb-3 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] text-right">24h</th>
								</tr>
							</thead>
							<tbody>
								{crypto.map((c: any) => {
									const change = fmtChange(c.change24h);
									return (
										<tr class="border-b border-[color:var(--color-rule)]">
											<td class="py-4">
												<span class="font-semibold text-[color:var(--color-ink)]">{c.symbol}</span>
												<span class="ml-2 text-sm text-[color:var(--color-ink-mute)]">{c.name}</span>
											</td>
											<td class="py-4 text-right tabular-nums">{fmtPrice(c.price)}</td>
											<td class={`py-4 text-right font-semibold tabular-nums ${change.cls}`}>{change.text}</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				)}
			</section>

			{/* ── Hacker News ── */}
			<section>
				<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 mb-8">
					<div class="editorial-rule h-px"></div>
					<h2 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Hacker News</h2>
					<div class="editorial-rule h-px"></div>
				</div>

				{hackerNews.length === 0 ? (
					<p class="text-[color:var(--color-ink-mute)] text-sm italic">No Hacker News data available.</p>
				) : (
					<ul class="space-y-6">
						{hackerNews.map((story: any) => (
							<li class="group">
								<a href={story.url} target="_blank" rel="noopener noreferrer" class="block">
									<h3 class="text-lg font-semibold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-accent)] transition-colors leading-snug">
										{story.title}
									</h3>
								</a>
								<div class="mt-1 flex items-center gap-3 font-mono text-xs text-[color:var(--color-ink-mute)]">
									<span>{story.points} pts</span>
									<span class="h-px w-4 bg-[color:var(--color-rule)]"></span>
									<a href={story.hnUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[color:var(--color-accent)] transition-colors">
										{story.comments} comments
									</a>
								</div>
							</li>
						))}
					</ul>
				)}
			</section>

			{/* ── TechCrunch ── */}
			<section>
				<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 mb-8">
					<div class="editorial-rule h-px"></div>
					<h2 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">TechCrunch</h2>
					<div class="editorial-rule h-px"></div>
				</div>

				{techCrunch.length === 0 ? (
					<p class="text-[color:var(--color-ink-mute)] text-sm italic">No TechCrunch data available.</p>
				) : (
					<ul class="space-y-6">
						{techCrunch.map((item: any) => (
							<li class="group">
								<a href={item.url} target="_blank" rel="noopener noreferrer" class="block">
									<h3 class="text-lg font-semibold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-accent)] transition-colors leading-snug">
										{item.title}
									</h3>
									<div class="mt-1 flex items-center gap-3 font-mono text-xs text-[color:var(--color-ink-mute)]">
										{item.creator && (
											<>
												<span>{item.creator}</span>
												<span class="h-px w-4 bg-[color:var(--color-rule)]"></span>
											</>
										)}
										{item.pubDate && (
											<time>{new Date(item.pubDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit' }).toUpperCase()}</time>
										)}
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</section>

			{/* ── Quick Take ── */}
			<section>
				<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 mb-8">
					<div class="editorial-rule h-px"></div>
					<h2 class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)]">Quick Take</h2>
					<div class="editorial-rule h-px"></div>
				</div>

				<div class="bg-[color:var(--color-paper-deep)] border border-[color:var(--color-rule)] p-8">
					<p class="text-[color:var(--color-ink)] leading-relaxed italic">
						{tracking.quickTake || "No quick take yet. This section will contain brief commentary on what's interesting in the data above."}
					</p>
				</div>
			</section>

		</div>
	</div>
</Layout>
