---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Resolve audio file path at build time; pass src only if the file exists
const audioFile = path.join(process.cwd(), 'public', 'audio', 'blog', `${post.slug}.mp3`);
const audioSrc = fs.existsSync(audioFile) ? `/audio/blog/${post.slug}.mp3` : undefined;
---

<Layout
	title={post.data.title}
	description={post.data.description}
	canonicalPath={`/blog/${post.slug}`}
	ogType="article"
>
	<div class="max-w-3xl mx-auto">
		<article class="prose prose-lg max-w-none">
			<header class="mb-14 not-prose border-b border-[color:var(--color-rule)] pb-10">
				<a href="/essays" class="arrow-shift mb-10 inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] transition-colors hover:text-[color:var(--color-accent)]">
					<span class="arrow" aria-hidden="true">←</span> All writing
				</a>
				<div class="flex flex-wrap items-center gap-3 mb-7 font-mono text-[11px] text-[color:var(--color-ink-mute)]">
					<span class="uppercase tracking-[0.18em]">Post</span>
					<span class="h-px w-6 bg-[color:var(--color-rule)]"></span>
					<time class="text-[color:var(--color-accent)]">
						{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase()}
					</time>
					<span class="h-px w-6 bg-[color:var(--color-rule)]"></span>
					<span>{post.data.author}</span>
				</div>
				<h1 class="display text-[clamp(3.2rem,8vw,5.75rem)] leading-[0.94] mb-8">
					{post.data.title}
				</h1>
				<p class="border-l-2 border-[color:var(--color-accent)] pl-5 text-xl text-[color:var(--color-ink-mute)] leading-[1.55] md:text-2xl">
					{post.data.description}
				</p>
				<AudioPlayer audioSrc={audioSrc} title={post.data.title} />
			</header>
			<Content />
		</article>
	</div>
</Layout>

<style is:global>
	/* === Base Typography === */
	article.prose p {
		margin-bottom: 1.5em !important;
		line-height: 1.85 !important;
		font-size: 1.0625rem !important;
		color: var(--color-ink-soft) !important;
		font-weight: 400 !important;
	}

	article.prose > p:first-of-type {
		font-size: 1.15rem !important;
		line-height: 1.8 !important;
		color: var(--color-ink) !important;
	}

	article.prose strong {
		font-weight: 600 !important;
		color: var(--color-ink) !important;
	}

	article.prose em {
		font-style: italic !important;
	}

	/* === Links === */
	article.prose a {
		text-decoration: underline !important;
		text-decoration-color: rgb(184 84 44 / 0.35) !important;
		text-underline-offset: 3px !important;
		transition: text-decoration-color 0.2s ease !important;
		color: var(--color-accent) !important;
	}

	article.prose a:hover {
		text-decoration-color: rgb(184 84 44 / 0.85) !important;
	}

	/* === Headings === */
	article.prose h2 {
		font-family: var(--font-serif) !important;
		font-size: 2.125rem !important;
		font-weight: 500 !important;
		margin-top: 2.5em !important;
		margin-bottom: 0.75em !important;
		letter-spacing: 0 !important;
		color: var(--color-ink) !important;
		line-height: 1.2 !important;
	}

	article.prose h3 {
		font-family: var(--font-serif) !important;
		font-size: 1.5rem !important;
		font-weight: 500 !important;
		margin-top: 2em !important;
		margin-bottom: 0.6em !important;
		letter-spacing: 0 !important;
		color: var(--color-ink) !important;
		line-height: 1.3 !important;
	}

	article.prose h4 {
		font-size: 1.125rem !important;
		font-weight: 600 !important;
		margin-top: 1.75em !important;
		margin-bottom: 0.5em !important;
		color: var(--color-ink-soft) !important;
	}

	/* === Lists === */
	article.prose ul,
	article.prose ol {
		margin: 0.75rem 0 1.5rem 0 !important;
		padding-left: 1.5rem !important;
	}

	article.prose ul { list-style: disc !important; }
	article.prose ol { list-style: decimal !important; }

	article.prose li {
		display: list-item !important;
		margin: 0.35rem 0 !important;
		line-height: 1.75 !important;
		font-size: 1.0625rem !important;
		color: var(--color-ink-soft) !important;
	}

	article.prose li > p {
		margin-bottom: 0.5em !important;
	}

	/* === Checkbox lists (task lists) === */
	article.prose ul:has(input[type="checkbox"]) {
		list-style: none !important;
		padding-left: 0.25rem !important;
	}

	article.prose li:has(> input[type="checkbox"]) {
		display: flex !important;
		align-items: baseline !important;
		gap: 0.5rem !important;
	}

	article.prose input[type="checkbox"] {
		accent-color: var(--color-accent) !important;
		margin-top: 0.25rem !important;
		flex-shrink: 0 !important;
	}

	/* === Code: Inline === */
	article.prose :not(pre) > code {
		font-size: 0.875em !important;
		font-weight: 500 !important;
		color: var(--color-accent) !important;
		background: var(--color-paper-deep) !important;
		padding: 0.15em 0.4em !important;
		border-radius: 0.3rem !important;
		border: 1px solid var(--color-rule) !important;
	}

	/* === Code: Blocks === */
	article.prose pre {
		background: var(--color-ink) !important;
		border: 1px solid rgba(26, 26, 26, 0.2) !important;
		border-radius: 0.25rem !important;
		padding: 1.25rem 1.5rem !important;
		margin: 1.5rem 0 2rem 0 !important;
		overflow-x: auto !important;
		font-size: 0.875rem !important;
		line-height: 1.7 !important;
		box-shadow: none !important;
	}

	article.prose pre code {
		font-size: 0.875rem !important;
		color: #e2e8f0 !important;
		background: transparent !important;
		padding: 0 !important;
		border: none !important;
		border-radius: 0 !important;
		font-weight: 400 !important;
	}

	/* === Blockquotes === */
	article.prose blockquote {
		border-left: 3px solid var(--color-accent) !important;
		background: var(--color-paper-deep) !important;
		padding: 1rem 1.25rem !important;
		margin: 1.5rem 0 2rem 0 !important;
		border-radius: 0 !important;
		font-style: normal !important;
	}

	article.prose blockquote p {
		color: var(--color-ink-soft) !important;
		font-size: 1rem !important;
		margin-bottom: 0.5em !important;
	}

	article.prose blockquote p:last-child {
		margin-bottom: 0 !important;
	}

	/* === Horizontal Rules === */
	article.prose hr {
		border: none !important;
		height: 1px !important;
		background-image: linear-gradient(to right, var(--color-rule) 50%, transparent 50%) !important;
		background-size: 6px 1px !important;
		background-repeat: repeat-x !important;
		margin: 3rem 0 !important;
	}

	/* === Tables === */
	article.prose table {
		width: 100% !important;
		border-collapse: separate !important;
		border-spacing: 0 !important;
		margin: 1.5rem 0 2rem 0 !important;
		font-size: 0.9375rem !important;
		border-radius: 0 !important;
		overflow: hidden !important;
		border: 1px solid var(--color-rule) !important;
	}

	article.prose thead {
		background: var(--color-paper-deep) !important;
	}

	article.prose th {
		font-family: var(--font-mono) !important;
		font-weight: 500 !important;
		text-align: left !important;
		padding: 0.75rem 1rem !important;
		font-size: 0.8125rem !important;
		text-transform: uppercase !important;
		letter-spacing: 0.05em !important;
		color: var(--color-ink-mute) !important;
		border-bottom: 1px solid var(--color-rule) !important;
	}

	article.prose td {
		padding: 0.75rem 1rem !important;
		border-bottom: 1px solid var(--color-rule) !important;
		color: var(--color-ink-soft) !important;
	}

	article.prose tbody tr:last-child td {
		border-bottom: none !important;
	}

	article.prose tbody tr:hover {
		background: rgb(237 230 214 / 0.5) !important;
	}

	/* === Images === */
	article.prose img {
		border-radius: 0.25rem !important;
		margin: 2rem 0 !important;
		border: 1px solid var(--color-rule) !important;
		box-shadow: none !important;
	}

	/* === Responsive fine-tuning === */
	@media (max-width: 640px) {
		article.prose p,
		article.prose li {
			font-size: 1rem !important;
		}

		article.prose > p:first-of-type {
			font-size: 1.0625rem !important;
		}

		article.prose h2 {
			font-size: 1.5rem !important;
			margin-top: 2em !important;
		}

		article.prose h3 {
			font-size: 1.25rem !important;
		}

		article.prose pre {
			padding: 1rem !important;
			font-size: 0.8125rem !important;
			border-radius: 0.5rem !important;
			margin-left: -0.5rem !important;
			margin-right: -0.5rem !important;
		}

		article.prose table {
			font-size: 0.8125rem !important;
		}

		article.prose th,
		article.prose td {
			padding: 0.5rem 0.75rem !important;
		}
	}
</style>
