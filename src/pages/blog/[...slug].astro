---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Resolve audio file path at build time; pass src only if the file exists
const audioFile = path.join(process.cwd(), 'public', 'audio', 'blog', `${post.slug}.mp3`);
const audioSrc = fs.existsSync(audioFile) ? `/audio/blog/${post.slug}.mp3` : undefined;
---

<Layout
	title={post.data.title}
	description={post.data.description}
	canonicalPath={`/blog/${post.slug}`}
	ogType="article"
>
	<article class="prose prose-lg prose-slate max-w-none prose-headings:tracking-tight prose-headings:font-black prose-a:text-purple-600 hover:prose-a:text-purple-500 transition-colors">
		<header class="mb-8 not-prose">
			<div class="flex items-center gap-3 mb-6">
				<time class="text-xs font-bold text-orange-500 tracking-wider">
					{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase()}
				</time>
				<span class="w-1 h-1 rounded-full bg-gray-300"></span>
				<span class="text-xs font-bold text-gray-400 uppercase tracking-widest">{post.data.author}</span>
			</div>
			<h1 class="text-5xl font-black tracking-tighter leading-tight mb-4">
				{post.data.title}
			</h1>
			<p class="text-2xl text-gray-500 font-light leading-relaxed">
				{post.data.description}
			</p>
			<AudioPlayer audioSrc={audioSrc} title={post.data.title} />
		</header>
		<Content />
	</article>
</Layout>

<style is:global>
	article.prose p {
		margin-bottom: 1.5em !important;
		line-height: 1.8 !important;
		font-size: 1.05rem !important;
	}

	article.prose ul,
	article.prose ol {
		margin: 1rem 0 1.5rem 0 !important;
		padding-left: 1.5rem !important;
	}

	article.prose ul { list-style: disc !important; }
	article.prose ol { list-style: decimal !important; }

	article.prose li {
		display: list-item !important;
		margin: 0.35rem 0 !important;
		line-height: 1.7 !important;
	}
	
	article.prose h2 {
		font-size: 2rem !important;
		font-weight: 900 !important;
		margin-top: 1.5em !important;
		margin-bottom: 1em !important;
		letter-spacing: -0.025em !important;
	}
	
	article.prose h3 {
		font-size: 1.5rem !important;
		font-weight: 800 !important;
		margin-top: 2em !important;
		margin-bottom: 0.75em !important;
		letter-spacing: -0.015em !important;
	}
</style>
