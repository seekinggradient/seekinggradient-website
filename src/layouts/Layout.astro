---
interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	ogType?: 'website' | 'article';
}

const {
	title,
	description = 'Seeking Gradient explores autonomous agents, infrastructure, and practical lessons from building on the internet.',
	canonicalPath = '/',
	ogType = 'website',
} = Astro.props;

const SITE_URL = 'https://seekinggradient.com';
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="theme-color" content="#f6f2ea" />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Seeking Gradient" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

		<style is:global>
			:root {
				--color-paper: #f6f2ea;
				--color-paper-deep: #ede6d6;
				--color-ink: #1a1a1a;
				--color-ink-soft: #3b3a36;
				--color-ink-mute: #6b6862;
				--color-rule: #d9d2bf;
				--color-accent: #b8542c;
				--color-accent-soft: #e9c9b5;
				--font-serif: "Fraunces", ui-serif, Georgia, serif;
				--font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
				--font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
			}

			html {
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
				font-feature-settings: "ss01", "cv11";
			}

			body {
				margin: 0;
				background-color: var(--color-paper);
				color: var(--color-ink);
				font-family: var(--font-sans);
			}

			::selection {
				background-color: var(--color-accent-soft);
				color: var(--color-ink);
			}

			.font-serif {
				font-family: var(--font-serif);
			}

			.font-mono {
				font-family: var(--font-mono);
			}

			.display {
				font-family: var(--font-serif);
				font-weight: 400;
				letter-spacing: 0;
				line-height: 0.95;
				font-variation-settings: "opsz" 144, "SOFT" 50;
			}

			.display-italic {
				font-style: italic;
			}

			.editorial-rule {
				background-image: linear-gradient(to right, var(--color-rule) 50%, transparent 50%);
				background-size: 6px 1px;
				background-repeat: repeat-x;
				background-position: left center;
			}

			.link-underline {
				background-image: linear-gradient(currentColor, currentColor);
				background-position: 0 100%;
				background-repeat: no-repeat;
				background-size: 100% 1px;
				transition: background-size 200ms ease, color 200ms ease;
			}

			.link-underline:hover {
				background-size: 100% 2px;
			}

			pre::-webkit-scrollbar {
				height: 6px;
			}
			pre::-webkit-scrollbar-track {
				background: transparent;
			}
			pre::-webkit-scrollbar-thumb {
				background: rgba(184, 84, 44, 0.25);
				border-radius: 3px;
			}
			pre::-webkit-scrollbar-thumb:hover {
				background: rgba(184, 84, 44, 0.4);
			}

			:focus-visible {
				outline: 2px solid var(--color-accent);
				outline-offset: 2px;
				border-radius: 2px;
			}
		</style>
	</head>
	<body class="overflow-x-hidden leading-normal">
		<nav class="sticky top-0 z-50 bg-[color:var(--color-paper)]/90 backdrop-blur-md border-b border-[color:var(--color-rule)]">
			<div class="max-w-6xl mx-auto px-5 sm:px-8 h-20 flex justify-between items-center gap-8">
				<a href="/" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-xl bg-[color:var(--color-ink)] flex items-center justify-center text-white shadow-sm transition-transform group-hover:-translate-y-0.5">
						<span class="font-serif italic text-[19px] leading-none">sg</span>
					</div>
					<span class="display text-2xl sm:text-3xl group-hover:text-[color:var(--color-accent)] transition-colors">
						Seeking <span class="display-italic">Gradient</span>
					</span>
				</a>
				<div class="hidden md:flex items-center gap-6 text-sm text-[color:var(--color-ink-soft)]">
					<a href="/#blog" class="link-underline pb-0.5 hover:text-[color:var(--color-ink)]">Essays</a>
					<a href="/ideas" class="link-underline pb-0.5 hover:text-[color:var(--color-ink)]">Ideas</a>
					<a href="/tracking" class="link-underline pb-0.5 hover:text-[color:var(--color-ink)]">Tracking</a>
					<a href="mailto:seekinggradient@gmail.com" class="link-underline pb-0.5 text-[color:var(--color-accent)]">Contact</a>
				</div>
			</div>
		</nav>

		<main class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
			<slot />
		</main>

		<footer class="border-t border-[color:var(--color-rule)] mt-20 py-14">
			<div class="max-w-6xl mx-auto px-5 sm:px-8">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="display text-3xl mb-4">Seeking <span class="display-italic">Gradient</span></h2>
						<p class="text-[color:var(--color-ink-mute)] max-w-sm leading-relaxed">
							Exploring the intersection of autonomous agents, infrastructure, and the quiet gradients of the digital age.
						</p>
					</div>
					<div class="flex md:justify-end gap-12">
						<div>
							<h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-ink-mute)] mb-6">Links</h3>
							<ul class="space-y-4 text-sm text-[color:var(--color-ink-soft)]">
								<li><a href="/" class="link-underline pb-0.5 hover:text-[color:var(--color-accent)]">Home</a></li>
								<li><a href="/#blog" class="link-underline pb-0.5 hover:text-[color:var(--color-accent)]">Essays</a></li>
								<li><a href="/ideas" class="link-underline pb-0.5 hover:text-[color:var(--color-accent)]">Ideas</a></li>
								<li><a href="mailto:seekinggradient@gmail.com" class="link-underline pb-0.5 hover:text-[color:var(--color-accent)]">Email</a></li>
							</ul>
						</div>
					</div>
				</div>
				<div class="mt-14 pt-8 border-t border-[color:var(--color-rule)] flex flex-col md:flex-row justify-between gap-4 font-mono text-xs text-[color:var(--color-ink-mute)]">
					<span>&copy; 2026 Seeking Gradient. Built with Astro & OpenClaw.</span>
					<div class="flex gap-6">
						<span>Privacy-First</span>
						<span>No Tracking</span>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
