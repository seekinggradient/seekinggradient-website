---
interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	ogType?: 'website' | 'article';
	fullBleed?: boolean;
	image?: string;
}

const {
	title,
	description = 'Seeking Gradient explores autonomous agents, infrastructure, and practical lessons from building on the internet.',
	canonicalPath = '/',
	ogType = 'website',
	fullBleed = false,
	image,
} = Astro.props;

const SITE_URL = 'https://seekinggradient.com';
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
const imageUrl = image ? new URL(image, SITE_URL).toString() : undefined;
const isBooks = canonicalPath.startsWith('/books');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="theme-color" content="#f8e45c" />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Seeking Gradient" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		{imageUrl && <meta property="og:image" content={imageUrl} />}

		<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

		<style is:global>
			:root {
				--color-paper: #f7f1e7;
				--color-paper-deep: #ebe2d5;
				--color-ink: #17152b;
				--color-ink-soft: #3f3a54;
				--color-ink-mute: #716b7e;
				--color-rule: #cec4b6;
				--color-accent: #3154d8;
				--color-accent-soft: #cfd8ff;
				--color-yellow: #f8e45c;
				--color-orange: #ff7043;
				--color-pink: #ef67a7;
				--color-mint: #8bd8bd;
				--color-lilac: #d8ccff;
				--color-night: #17152b;
				--font-serif: "Fraunces", ui-serif, Georgia, serif;
				--font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
				--font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
				--page-gutter: clamp(1.25rem, 4vw, 3.5rem);
			}

			html {
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
				font-feature-settings: "ss01", "cv11";
			}

			body {
				margin: 0;
				background-color: var(--color-paper);
				color: var(--color-ink);
				font-family: var(--font-sans);
			}

			body::before {
				content: "";
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				opacity: 0.035;
				background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
			}

			::selection {
				background-color: var(--color-yellow);
				color: var(--color-ink);
			}

			.font-serif {
				font-family: var(--font-serif);
			}

			.font-mono {
				font-family: var(--font-mono);
			}

			.display {
				font-family: var(--font-serif);
				font-weight: 400;
				letter-spacing: -0.025em;
				line-height: 0.95;
				font-variation-settings: "opsz" 144, "SOFT" 50;
			}

			.display-italic {
				font-style: italic;
			}

			.editorial-rule {
				background-image: linear-gradient(to right, var(--color-rule) 50%, transparent 50%);
				background-size: 6px 1px;
				background-repeat: repeat-x;
				background-position: left center;
			}

			.link-underline {
				background-image: linear-gradient(currentColor, currentColor);
				background-position: 0 100%;
				background-repeat: no-repeat;
				background-size: 100% 1px;
				transition: background-size 200ms ease, color 200ms ease;
			}

			.link-underline:hover {
				background-size: 100% 2px;
			}

			.eyebrow {
				font-family: var(--font-mono);
				font-size: 0.69rem;
				font-weight: 500;
				line-height: 1.4;
				letter-spacing: 0.2em;
				text-transform: uppercase;
			}

			.button-primary,
			.button-secondary {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 3.25rem;
				padding: 0 1.25rem;
				font-size: 0.875rem;
				font-weight: 600;
				transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, color 180ms ease;
			}

			.button-primary {
				border: 1px solid var(--color-ink);
				background: var(--color-ink);
				color: var(--color-paper);
			}

			.button-primary:hover {
				transform: translateY(-2px);
				border-color: var(--color-accent);
				background: var(--color-accent);
			}

			.button-secondary {
				border: 1px solid var(--color-rule);
				color: var(--color-ink);
			}

			.button-secondary:hover {
				transform: translateY(-2px);
				border-color: var(--color-ink);
			}

			.arrow-shift .arrow {
				display: inline-block;
				transition: transform 180ms ease;
			}

			.arrow-shift:hover .arrow {
				transform: translateX(0.3rem);
			}

			.brand-mark {
				box-shadow: 4px 4px 0 var(--color-ink);
			}

			.nav-email {
				box-shadow: 3px 3px 0 var(--color-ink);
			}

			.nav-section-active {
				border-bottom: 3px solid var(--color-orange);
				background-size: 0 0 !important;
				color: var(--color-ink);
			}

			.nav-context {
				min-height: 2.55rem;
				border: 1px solid color-mix(in srgb, var(--color-orange), transparent 12%);
				border-radius: 0.45rem;
				padding: 0 1rem;
				color: var(--color-orange);
				font-size: 0.72rem;
				letter-spacing: 0.015em;
			}

			.footer-color {
				background: var(--color-yellow);
				color: var(--color-ink);
			}

			.site-menu summary {
				list-style: none;
				cursor: pointer;
			}

			.site-menu summary::-webkit-details-marker {
				display: none;
			}

			.site-menu[open] summary {
				color: var(--color-accent);
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					scroll-behavior: auto !important;
					animation-duration: 0.01ms !important;
					transition-duration: 0.01ms !important;
				}

			}

			pre::-webkit-scrollbar {
				height: 6px;
			}
			pre::-webkit-scrollbar-track {
				background: transparent;
			}
			pre::-webkit-scrollbar-thumb {
				background: rgba(184, 84, 44, 0.25);
				border-radius: 3px;
			}
			pre::-webkit-scrollbar-thumb:hover {
				background: rgba(184, 84, 44, 0.4);
			}

			:focus-visible {
				outline: 2px solid var(--color-accent);
				outline-offset: 2px;
				border-radius: 2px;
			}
		</style>
	</head>
	<body class="overflow-x-hidden leading-normal">
		<nav class="sticky top-0 z-50 bg-[color:var(--color-paper)]/88 backdrop-blur-xl border-b border-[color:var(--color-ink)]/15">
			<div class={`${isBooks ? 'max-w-[90rem]' : 'max-w-7xl'} mx-auto px-5 sm:px-8 h-[72px] flex justify-between items-center gap-5`}>
				<a href="/" class="group flex items-center gap-2.5" aria-label="Seeking Gradient home">
					<div class="brand-mark w-9 h-9 rounded-full bg-[color:var(--color-orange)] flex items-center justify-center text-[color:var(--color-ink)] transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:rotate-[-7deg]">
						<span class="font-serif italic text-[17px] leading-none">sg</span>
					</div>
					<span class="display text-[1.35rem] sm:text-[1.65rem] group-hover:text-[color:var(--color-accent)] transition-colors">
						Seeking <span class="display-italic">Gradient</span>
					</span>
				</a>
				<div class="hidden md:flex items-center gap-7 text-[13px] font-medium text-[color:var(--color-ink-soft)]">
					<a href="/essays" class="link-underline pb-0.5 hover:text-[color:var(--color-ink)]">Writing</a>
					<a href="/books" class:list={["link-underline pb-0.5 hover:text-[color:var(--color-ink)]", isBooks && "nav-section-active"]} aria-current={isBooks ? 'page' : undefined}>Books</a>
					<a href="/ideas" class="link-underline pb-0.5 hover:text-[color:var(--color-ink)]">Projects</a>
					<a href="/#about" class="link-underline pb-0.5 hover:text-[color:var(--color-ink)]">About</a>
					{isBooks ? (
						<span class="nav-context hidden lg:inline-flex items-center gap-4">A library for learning in public <span aria-hidden="true">✳</span></span>
					) : (
						<a href="mailto:seekinggradient@gmail.com" class="nav-email px-3 py-1.5 bg-[color:var(--color-yellow)] text-[color:var(--color-ink)] transition-transform hover:-rotate-2">Email ↗</a>
					)}
				</div>
				<details class="site-menu md:hidden relative">
					<summary class="eyebrow border border-[color:var(--color-rule)] px-3 py-2">Menu</summary>
					<div class="absolute right-0 top-[calc(100%+0.75rem)] w-48 border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] p-2 shadow-[0_20px_50px_rgb(21_23_22/0.12)]">
						<a href="/essays" class="block px-3 py-2.5 text-sm hover:bg-[color:var(--color-paper-deep)]">Writing</a>
						<a href="/books" class="block px-3 py-2.5 text-sm hover:bg-[color:var(--color-paper-deep)]">Books</a>
						<a href="/ideas" class="block px-3 py-2.5 text-sm hover:bg-[color:var(--color-paper-deep)]">Projects</a>
						<a href="/#about" class="block px-3 py-2.5 text-sm hover:bg-[color:var(--color-paper-deep)]">About</a>
						<a href="mailto:seekinggradient@gmail.com" class="block px-3 py-2.5 text-sm text-[color:var(--color-accent)] hover:bg-[color:var(--color-paper-deep)]">Email</a>
					</div>
				</details>
			</div>
		</nav>

		<main class={fullBleed ? '' : 'max-w-6xl mx-auto px-5 sm:px-8 py-14 sm:py-20'}>
			<slot />
		</main>

		<footer class="footer-color mt-20 py-10 sm:py-12">
			<div class="max-w-7xl mx-auto px-5 sm:px-8">
				<div class="grid grid-cols-1 md:grid-cols-[1.4fr_0.6fr] gap-10 items-end">
					<div>
						<h2 class="display text-3xl mb-4">Seeking <span class="display-italic">Gradient</span></h2>
						<p class="max-w-lg leading-relaxed opacity-75">
							A personal site for writing, projects, and things I'm learning by building.
						</p>
					</div>
					<div class="flex md:justify-end gap-14">
						<div>
							<ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm md:justify-end">
								<li><a href="/essays" class="link-underline pb-0.5">Writing</a></li>
								<li><a href="/books" class="link-underline pb-0.5">Books</a></li>
								<li><a href="/ideas" class="link-underline pb-0.5">Projects</a></li>
								<li><a href="/tracking" class="link-underline pb-0.5">Tracking</a></li>
								<li><a href="mailto:seekinggradient@gmail.com" class="link-underline pb-0.5">Email</a></li>
							</ul>
						</div>
					</div>
				</div>
				<div class="mt-10 pt-6 border-t border-[color:var(--color-ink)]/20 flex flex-col md:flex-row justify-between gap-4 font-mono text-[11px] opacity-65">
					<span>&copy; 2026 Seeking Gradient.</span>
					<span>No analytics.</span>
				</div>
			</div>
		</footer>

	</body>
</html>
