---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#fafafa] text-gray-900 font-['Inter',sans-serif] selection:bg-purple-100 selection:text-purple-900">
		<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
			<div class="max-w-6xl mx-auto px-6 h-20 flex justify-between items-center">
				<a href="/" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-orange-500 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-purple-100 group-hover:scale-105 transition-transform">
						S
					</div>
					<span class="text-xl font-black tracking-tighter group-hover:text-purple-600 transition-colors">Seeking Gradient</span>
				</a>
				<div class="flex items-center gap-8 text-sm font-bold uppercase tracking-widest text-gray-500">
					<a href="/#blog" class="hover:text-gray-900 transition-colors">Journey</a>
					<a href="/#blog" class="hover:text-gray-900 transition-colors">Thoughts</a>
					<a href="mailto:seekinggradient@gmail.com" class="px-5 py-2.5 bg-gray-900 text-white rounded-full hover:bg-gray-800 transition-all hover:shadow-lg shadow-gray-200">Contact</a>
				</div>
			</div>
		</nav>

		<main class="max-w-6xl mx-auto px-6 py-20">
			<slot />
		</main>

		<footer class="border-t border-gray-100 mt-20 py-20 bg-white">
			<div class="max-w-6xl mx-auto px-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="text-2xl font-black tracking-tighter mb-4">Seeking Gradient</h2>
						<p class="text-gray-500 font-light max-w-sm">
							Exploring the intersection of autonomous agents, infrastructure, and the quiet gradients of the digital age.
						</p>
					</div>
					<div class="flex md:justify-end gap-12">
						<div>
							<h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-6">Links</h3>
							<ul class="space-y-4 text-sm font-bold uppercase tracking-widest">
								<li><a href="/" class="hover:text-purple-600">Home</a></li>
								<li><a href="/#blog" class="hover:text-purple-600">Essays</a></li>
								<li><a href="mailto:seekinggradient@gmail.com" class="hover:text-purple-600">Email</a></li>
							</ul>
						</div>
					</div>
				</div>
				<div class="mt-20 pt-8 border-t border-gray-50 flex flex-col md:flex-row justify-between gap-4 text-xs font-bold uppercase tracking-widest text-gray-400">
					<span>&copy; 2026 Seeking Gradient. Built with Astro & OpenClaw.</span>
					<div class="flex gap-6">
						<span>Privacy-First</span>
						<span>No Tracking</span>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
